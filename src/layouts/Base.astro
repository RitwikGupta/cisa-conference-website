---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { event } from '../lib/content';
import { absolute, href } from '../lib/urls';
import Wordmark from '../components/Wordmark.astro';
interface Props {
  title: string;
  description: string;
  page?: string;
  noindex?: boolean;
}
const { title, description, page = '', noindex = false } = Astro.props;
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !noindex;
const canonical = new URL(Astro.url.pathname.replace(/\/404\/$/, '/404.html'), Astro.site).href;
const nav = [
  { label: 'Program', path: '/program/' },
  { label: 'Speakers', path: '/speakers/' },
  { label: 'Call for papers', path: '/contribute/' },
  { label: 'Attend', path: '/attend/' },
  { label: 'About', path: '/about/' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.name,
  description,
  startDate: event.startDate,
  endDate: event.endDate,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  url: absolute('/'),
  image: absolute('/social-card.png'),
  location: {
    '@type': 'Place',
    name: event.venue,
    address: {
      '@type': 'PostalAddress',
      addressLocality: event.city,
      addressRegion: event.region,
      addressCountry: event.country,
    },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <title>{page === 'home' ? event.name : `${title} · CISA 2027`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="theme-color" content="#F7F8F5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CISA 2027" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute('/social-card.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${event.name}. ${event.dateLabel} at ${event.venue}.`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main" tabindex="0">
      Skip to content
    </a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand-link" href={href('/')} aria-label="CISA 2027 home">
          <Wordmark />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
          <span>Menu</span>
          <span class="menu-lines" aria-hidden="true"></span>
        </button>
        <nav class="primary-nav" id="primary-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a
              href={href(item.path)}
              aria-current={page === item.path.split('/')[1] ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <a class="brand-link" href={href('/')} aria-label="CISA 2027 home">
            <Wordmark />
          </a>
          <p>IEEE Conference on Computational Imaging Using Synthetic Apertures</p>
          <p>© {event.edition} CISA Conference</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          {nav.map((item) => (
            <a href={href(item.path)}>{item.label}</a>
          ))}
        </nav>
        <a class="footer-email" href={`mailto:${event.email}`}>
          {event.email}
        </a>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.primary-nav');
      if (button && nav) {
        button.hidden = false;
        const media = window.matchMedia('(max-width: 800px)');
        const setOpen = (open: boolean) => {
          button.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
          nav.hidden = media.matches && !open;
        };
        setOpen(false);
        button.addEventListener('click', () =>
          setOpen(button.getAttribute('aria-expanded') !== 'true'),
        );
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            button.focus();
          }
        });
        document.addEventListener('click', (e) => {
          if (e.target instanceof Node && !nav.contains(e.target) && !button.contains(e.target))
            setOpen(false);
        });
        nav
          .querySelectorAll('a')
          .forEach((link) => link.addEventListener('click', () => setOpen(false)));
        media.addEventListener('change', () => setOpen(false));
      }
    </script>
  </body>
</html>
