---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Themes from '../components/Themes.astro';
import { event, program, speakers } from '../lib/content';
import { href } from '../lib/urls';
const page = (await getEntry('pages', 'program'))!;
const { Content } = await render(page);
const scheduled = program
  .filter((item) => item.data.date && item.data.start)
  .sort((a, b) => `${a.data.date}${a.data.start}`.localeCompare(`${b.data.date}${b.data.start}`));
const dates = [...new Set(scheduled.map((item) => item.data.date!))];
const tutorials = program.filter((item) => item.data.kind === 'tutorial');
const highlights = program.filter((item) => !item.data.start && item.data.kind !== 'tutorial');
const dateLabel = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', {
    timeZone: event.timezone,
    weekday: 'long',
    month: 'long',
    day: 'numeric',
  });
---

<Base {...page.data} page="program">
  <PageIntro {...page.data} />
  <div class="wrap">
    <div class="notice">
      <div class="prose">
        {program.length ? (
          <p>
            The confirmed program is listed below. Session times are local to College Park (
            {event.timezone}).
          </p>
        ) : (
          <Content />
        )}
      </div>
    </div>
  </div>
  <section class="section research-surface program-research" id="research-themes">
    <div class="wrap">
      <div class="section-top">
        <div>
          <h2>Research topics</h2>
          <p class="section-intro">
            These topics describe the conference’s research scope. Sessions and tutorials are listed
            separately when confirmed.
          </p>
        </div>
      </div>
      <Themes expanded />
    </div>
  </section>
  {highlights.length > 0 && (
    <section class="section wrap border-section">
      <h2>Technical sessions</h2>
      {highlights.map(({ data }) => (
        <article class="schedule-entry">
          <span class="schedule-kind">{data.kind}</span>
          <div>
            <h3>{data.title}</h3>
            <p>{data.description}</p>
          </div>
        </article>
      ))}
    </section>
  )}
  <section class="section wrap border-section" id="tutorials">
    <div class="section-top">
      <div>
        <h2>Tutorials</h2>
      </div>
    </div>
    {tutorials.length ? (
      tutorials.map(({ data }) => (
        <article class="schedule-entry">
          <span class="schedule-kind">Tutorial</span>
          <div>
            <h3>{data.title}</h3>
            <p>{data.description}</p>
          </div>
        </article>
      ))
    ) : (
      <p class="pending">Tutorials will be announced.</p>
    )}
  </section>
  <section class="section wrap border-section" id="schedule">
    <div class="section-top">
      <div>
        <h2>Schedule</h2>
      </div>
    </div>
    {dates.length ? (
      <div class="schedule">
        {dates.map((date) => (
          <section class="schedule-day">
            <h3>{dateLabel(date)}</h3>
            {scheduled
              .filter((item) => item.data.date === date)
              .map(({ data }) => (
                <article class="schedule-entry">
                  <div>
                    <time datetime={`${data.date}T${data.start}`}>
                      {data.start}–{data.end}
                    </time>
                  </div>
                  <div>
                    <h4>{data.title}</h4>
                    <p class="schedule-kind">{data.kind}</p>
                    <p>{data.description}</p>
                    {data.speakerIds.length > 0 && (
                      <p>
                        {data.speakerIds.map((id, index) => (
                          <>
                            {index > 0 && ' · '}
                            <a href={href(`/speakers/${id}/`)}>
                              {speakers.find((speaker) => speaker.id === id)!.data.name}
                            </a>
                          </>
                        ))}
                      </p>
                    )}
                    {data.location && <p>{data.location}</p>}
                  </div>
                </article>
              ))}
          </section>
        ))}
      </div>
    ) : (
      <p class="pending">
        The schedule will be announced. Times will be shown in the conference’s local timezone.
      </p>
    )}
  </section>
</Base>
