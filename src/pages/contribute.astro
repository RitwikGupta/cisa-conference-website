---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { event, deadlines } from '../lib/content';
import { href } from '../lib/urls';
const page = (await getEntry('pages', 'contribute'))!;
const { Content } = await render(page);
---

<Base {...page.data} page="contribute">
  <PageIntro {...page.data} />
  <div class="wrap intro-actions">
    <a class="button" href={href(event.cfp)} download>
      Download the PDF <Icon name="download" size={18} />
    </a>
    <p class="file-details">2027 call for papers · PDF · 1 page · 395 KB</p>
  </div>
  <div class="wrap page-content content-columns">
    <article class="prose">
      <Content />
      <h2>Research scope inquiries</h2>
      <p>
        For questions about the suitability of a contribution, contact{' '}
        <a href={`mailto:${event.email}`}>{event.email}</a>.
      </p>
      <p>
        <a href={href('/program/#research-themes')}>Research topics</a>
      </p>
    </article>
    <aside class="sidebar-stack" aria-label="Submission information">
      <section class="sidebar-section">
        <h2>Submission information</h2>
        {event.submission?.confirmed ? (
          <>
            <p>The submission portal is open.</p>
            <a class="button" href={event.submission.url}>
              {event.submission.label}
              <Icon name="external" size={18} />
            </a>
          </>
        ) : (
          <p>The submission portal will be announced.</p>
        )}
      </section>
      {deadlines.length > 0 && (
        <section class="sidebar-section">
          <h2>Important dates</h2>
          <dl class="fact-list section-copy">
            {deadlines.map(({ data }) => (
              <div>
                <dt>{data.title}</dt>
                <dd>
                  <time datetime={data.datetime}>{data.dateLabel}</time>
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )}
    </aside>
  </div>
</Base>
