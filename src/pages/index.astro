---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ConferenceHome from '../components/ConferenceHome.astro';
import { event, speakers, program, deadlines } from '../lib/content';
const home = (await getEntry('pages', 'home'))!;
const { Content } = await render(home);
const featured = speakers.filter((speaker) => speaker.data.featured).slice(0, 3);
---

<Base {...home.data} page="home">
  <ConferenceHome
    event={event}
    intro={home.data.intro}
    programAvailable={program.length > 0}
    speakersAvailable={speakers.length > 0}
    featured={featured}
    deadlines={deadlines}
  >
    <Content />
  </ConferenceHome>
</Base>
