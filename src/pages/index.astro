---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Aperture from '../components/Aperture.astro';
import Icon from '../components/Icon.astro';
import Themes from '../components/Themes.astro';
import Participation from '../components/Participation.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import { event, speakers, deadlines } from '../lib/content';
import { href } from '../lib/urls';
const home = (await getEntry('pages', 'home'))!;
const { Content } = await render(home);
const featured = speakers.filter((speaker) => speaker.data.featured).slice(0, 3);
---

<Base {...home.data} page="home">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="conference-name">{event.name} (CISA)</p>
      <h1>
        Advancing
        <br />
        computational
        <br />
        imaging, <em>together.</em>
      </h1>
      <p class="hero-description">{home.data.intro}</p>
      <div class="hero-event">
        <span>
          <Icon name="calendar" size={16} />
          <time datetime={event.startDate}>{event.dateLabel}</time>
        </span>
        <span>
          <Icon name="pin" size={16} />
          {event.venue} · {event.city}, MD
        </span>
      </div>
      <div class="hero-actions">
        <a class="button" href={href('/program/')}>
          Explore the program <Icon size={18} />
        </a>
        <a class="button button-outline" href={href('/contribute/')}>
          Call for papers <Icon name="external" size={18} />
        </a>
      </div>
    </div>
    <Aperture />
  </section>
  <div class="conference-strip">
    <div class="wrap conference-strip-inner">
      <div class="conference-strip-item">
        <span class="strip-number">04</span>
        <div>
          <p class="strip-value">A continuing conversation</p>
          <p class="strip-label">The fourth annual CISA conference</p>
        </div>
      </div>
      <div class="conference-strip-item">
        <Icon name="calendar" size={27} />
        <div>
          <p class="strip-value">Three days. New perspectives.</p>
          <p class="strip-label">{event.dateLabel} · In person</p>
        </div>
      </div>
      <div class="conference-strip-item">
        <Icon name="pin" size={27} />
        <div>
          <p class="strip-value">{event.venue}</p>
          <p class="strip-label">
            {event.city}, {event.region}
          </p>
        </div>
      </div>
    </div>
  </div>
  <section class="section wrap" aria-labelledby="program-heading">
    <div class="section-top">
      <div>
        <p class="eyebrow">01 / IDEAS & PEOPLE</p>
        <h2 id="program-heading">
          Big questions.
          <br />
          Different perspectives.
        </h2>
      </div>
      <a class="text-link" href={href('/program/')}>
        Inside the program <Icon size={19} />
      </a>
    </div>
    {featured.length ? (
      <div class="speaker-grid">
        {featured.map((speaker) => (
          <SpeakerCard speaker={speaker} />
        ))}
      </div>
    ) : (
      <div class="program-feature">
        <div class="program-feature-main">
          <span class="status-label">LOOKING AHEAD TO 2027</span>
          <h3>The next idea might come from another field.</h3>
          <p>
            Explore the connections between synthetic apertures, inverse problems, and AI. Find
            familiar challenges in a different instrument—and new ways to approach your own.
          </p>
          <a class="text-link" href={href('/program/#research-themes')}>
            Explore the research connections <Icon size={19} />
          </a>
        </div>
        <div class="program-feature-aside">
          <Icon name="spark" size={34} />
          <h3>Meet the minds behind the methods.</h3>
          <p>
            The 2027 speakers and technical sessions will be announced here. There’s more to come.
          </p>
          <a class="text-link" href={href('/speakers/')}>
            Speaker announcements <Icon size={19} />
          </a>
        </div>
      </div>
    )}
  </section>
  <section class="section research-section wrap" aria-labelledby="research-heading">
    <div class="section-top">
      <div>
        <p class="eyebrow">02 / FIND YOUR CONNECTION</p>
        <h2 id="research-heading">
          Many fields.
          <br />A shared way of seeing.
        </h2>
        <p class="section-intro">
          You don’t have to work in the same discipline to work on the same problem. Find your place
          in the conversation.
        </p>
      </div>
    </div>
    <Themes />
  </section>
  {deadlines.length > 0 && (
    <section class="section wrap border-section">
      <p class="eyebrow">DATES TO KNOW</p>
      <h2>Make room for your next idea.</h2>
      <dl class="fact-list">
        {deadlines.map(({ data }) => (
          <div>
            <dt>{data.title}</dt>
            <dd>
              <time datetime={data.datetime}>{data.dateLabel}</time>
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )}
  <section class="section community-section">
    <div class="wrap community-grid">
      <div class="community-copy">
        <p class="eyebrow">03 / THE CISA COMMUNITY</p>
        <h2>
          Built on connections.
          <br />
          Open to what’s next.
        </h2>
        <Content />
        <a class="text-link" href={href('/about/')}>
          Get to know CISA <Icon size={19} />
        </a>
      </div>
      <div class="community-facts">
        <div class="community-fact">
          <span>04</span>
          <div>
            <h3>A growing tradition</h3>
            <p>The fourth annual gathering in 2027.</p>
          </div>
        </div>
        <div class="community-fact">
          <span>01</span>
          <div>
            <h3>A shared foundation</h3>
            <p>Physics, computation, and the power of better measurements.</p>
          </div>
        </div>
        <div class="community-fact">
          <Icon name="astro" size={48} />
          <div>
            <h3>Perspectives across scales</h3>
            <p>From microscopic structures to the world beyond.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <Participation />
</Base>
