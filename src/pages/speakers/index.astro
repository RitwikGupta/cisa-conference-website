---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import SpeakerCard from '../../components/SpeakerCard.astro';
import Participation from '../../components/Participation.astro';
import Icon from '../../components/Icon.astro';
import { speakers } from '../../lib/content';
import { href } from '../../lib/urls';
const page = (await getEntry('pages', 'speakers'))!;
const { Content } = await render(page);
---

<Base {...page.data} page="speakers">
  <PageIntro {...page.data} />
  <section class="wrap page-content">
    {speakers.length ? (
      <div class="speaker-grid">
        {speakers.map((speaker) => (
          <SpeakerCard speaker={speaker} />
        ))}
      </div>
    ) : (
      <div class="program-feature">
        <div class="program-feature-main">
          <span class="status-label">2027 ANNOUNCEMENTS TO COME</span>
          <h2>
            Fresh thinking.
            <br />
            Shared in person.
          </h2>
          <div class="prose">
            <Content />
          </div>
        </div>
        <div class="program-feature-aside">
          <Icon name="spark" size={38} />
          <h3>Start with the ideas.</h3>
          <p>Discover the themes linking researchers across imaging, sensing, and computation.</p>
          <a class="text-link" href={href('/program/#research-themes')}>
            Explore research themes <Icon size={20} />
          </a>
        </div>
      </div>
    )}
  </section>
  <Participation />
</Base>
