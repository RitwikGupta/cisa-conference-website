---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { speakers } from '../../lib/content';
import { href } from '../../lib/urls';
export function getStaticPaths() {
  return speakers.map((speaker) => ({ params: { slug: speaker.id }, props: { speaker } }));
}
interface Props {
  speaker: CollectionEntry<'speakers'>;
}
const { speaker } = Astro.props;
const { data } = speaker;
const { Content } = await render(speaker);
---

<Base
  title={data.name}
  description={`${data.name}, ${data.affiliation}. ${data.talkTitle || 'CISA 2027 speaker.'}`}
  page="speakers"
>
  <section class="wrap page-intro">
    <a class="text-link" href={href('/speakers/')}>
      All speakers
    </a>
    <h1>{data.name}</h1>
    <p class="intro-text">{data.affiliation}</p>
    <p class="speaker-role">{data.role}</p>
  </section>
  <div class="wrap page-content content-columns">
    <div class="prose">
      {data.talkTitle && (
        <>
          <h2>{data.talkTitle}</h2>
          {data.abstract && <p>{data.abstract}</p>}
        </>
      )}
      <h2>Biography</h2>
      <Content />
      {data.website && (
        <p>
          <a href={data.website}>Speaker website</a>
        </p>
      )}
    </div>
    {data.portrait && (
      <figure class="speaker-profile-image">
        <Image
          src={data.portrait}
          alt={data.name}
          width={520}
          widths={[320, 520, 780]}
          sizes="(max-width: 800px) 100vw, 40vw"
        />
        {data.portraitCredit && <figcaption class="photo-credit">{data.portraitCredit}</figcaption>}
      </figure>
    )}
  </div>
</Base>
