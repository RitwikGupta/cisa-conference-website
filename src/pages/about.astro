---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { event, organizers } from '../lib/content';
import { href } from '../lib/urls';
const page = (await getEntry('pages', 'about'))!;
const { Content } = await render(page);
---

<Base {...page.data} page="about">
  <PageIntro {...page.data} />
  <div class="wrap page-content">
    <div class="prose">
      <Content />
    </div>
    <section class="section border-section" id="organizers">
      <h2>Organizers</h2>
      {organizers.length ? (
        <dl class="fact-list section-copy">
          {organizers.map(({ data }) => (
            <div>
              <dt>{data.role}</dt>
              <dd>
                {data.website ? <a href={data.website}>{data.name}</a> : data.name}
                {data.affiliation && <p>{data.affiliation}</p>}
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="pending">The organizing committee will be announced.</p>
      )}
    </section>
    <section class="section border-section" id="affiliations">
      <h2>Conference affiliations</h2>
      <p class="section-intro">
        The <a href={href(event.cfp)}>2027 call for papers (PDF)</a> is issued by the University of
        Maryland, IEEE-USA, and the IEEE Synthetic Aperture Standards Committee.
      </p>
      <div class="affiliations">
        <div class="affiliation">
          <img
            src={href('/affiliations/ieee-usa.png')}
            alt="IEEE-USA"
            width="257"
            height="55"
            loading="lazy"
          />
          <p>Named in the 2027 call for papers</p>
        </div>
        <div class="affiliation">
          <img
            src={href('/affiliations/maryland.svg')}
            alt="University of Maryland"
            width="314"
            height="50"
            loading="lazy"
          />
          <p>Host institution</p>
        </div>
        <div class="affiliation">
          <h3>IEEE Synthetic Aperture Standards Committee</h3>
          <p>Named in the 2027 call for papers</p>
        </div>
      </div>
    </section>
    <section class="section border-section" id="support-cisa">
      <h2>Sponsorship and contact</h2>
      <p class="section-intro">
        For sponsorship, exhibits, or conference inquiries, contact{' '}
        <a href={`mailto:${event.email}`}>{event.email}</a>.
      </p>
    </section>
  </div>
</Base>
