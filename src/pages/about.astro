---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Participation from '../components/Participation.astro';
import Icon from '../components/Icon.astro';
import { event, organizers } from '../lib/content';
import { href } from '../lib/urls';
const page = (await getEntry('pages', 'about'))!;
const { Content } = await render(page);
---

<Base {...page.data} page="about">
  <PageIntro {...page.data} />
  <div class="wrap page-content content-columns">
    <div class="prose">
      <Content />
      <p>
        <a href={href(event.cfp)}>Read the official 2027 call for papers (PDF)</a>
      </p>
    </div>
    <aside class="sidebar-stack">
      <div class="notice">
        <p class="eyebrow">CISA 2027</p>
        <h2>{event.sequence}</h2>
        <p>
          {event.dateLabel}
          <br />
          {event.venue}
          <br />
          {event.city}, {event.region}
        </p>
        <a class="text-link" href={href('/attend/')}>
          Join us in Maryland <Icon size={18} />
        </a>
      </div>
      <div class="notice" id="organizers">
        <h2>The people behind CISA</h2>
        {organizers.length ? (
          <dl class="fact-list">
            {organizers.map(({ data }) => (
              <div>
                <dt>{data.role}</dt>
                <dd>
                  {data.website ? <a href={data.website}>{data.name}</a> : data.name}
                  {data.affiliation && <p>{data.affiliation}</p>}
                </dd>
              </div>
            ))}
          </dl>
        ) : (
          <p>The confirmed 2027 organizing committee and roles will be announced here.</p>
        )}
        <a class="text-link" href={`mailto:${event.email}`}>
          Contact the organizers <Icon name="external" size={18} />
        </a>
      </div>
    </aside>
  </div>
  <section class="section wrap border-section" id="affiliations">
    <p class="eyebrow">CONFERENCE AFFILIATIONS</p>
    <h2>Bringing the community together.</h2>
    <p class="section-intro">
      The 2027 call for papers is an invitation from the University of Maryland, IEEE-USA, and the
      IEEE Synthetic Aperture Standards Committee.
    </p>
    <div class="affiliations">
      <div class="affiliation">
        <img
          src={href('/affiliations/ieee-usa.png')}
          alt="IEEE-USA"
          width="257"
          height="55"
          loading="lazy"
        />
        <p>Named in the 2027 call for papers</p>
      </div>
      <div class="affiliation">
        <img
          src={href('/affiliations/maryland.svg')}
          alt="University of Maryland"
          width="314"
          height="50"
          loading="lazy"
        />
        <p>Host institution</p>
      </div>
      <div class="affiliation">
        <h3>
          IEEE Synthetic Aperture
          <br />
          Standards Committee
        </h3>
        <p>Named in the 2027 call for papers</p>
      </div>
    </div>
  </section>
  <section class="section wrap border-section" id="support-cisa">
    <div class="content-columns">
      <div>
        <p class="eyebrow">SUPPORT THE CONVERSATION</p>
        <h2>
          Connect with the
          <br />
          CISA community.
        </h2>
        <p class="section-intro">
          For sponsorship, exhibits, or other ways to support the conference, get in touch with the
          organizers.
        </p>
      </div>
      <div class="notice">
        <Icon name="mail" size={30} />
        <h3>Let’s start a conversation.</h3>
        <p>
          <a class="contact-link" href={`mailto:${event.email}`}>
            {event.email}
          </a>
        </p>
      </div>
    </div>
  </section>
  <Participation />
</Base>
