---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { event } from '../lib/content';
import { href } from '../lib/urls';
const page = (await getEntry('pages', 'attend'))!;
const { Content } = await render(page);
---

<Base {...page.data} page="attend">
  <PageIntro {...page.data} />
  <div class="wrap intro-actions">
    <p class="event-details">
      <time datetime={event.startDate}>{event.dateLabel}</time> · {event.venue} · {event.city},{' '}
      {event.region}
    </p>
  </div>
  <div class="wrap page-content content-columns">
    <div class="prose">
      <Content />
      <p>
        <a href={`mailto:${event.email}`}>{event.email}</a>
      </p>
    </div>
    <aside class="sidebar-stack" aria-label="Conference details">
      <section class="sidebar-section">
        <h2>Registration</h2>
        {event.registration?.confirmed ? (
          <>
            <p>Registration for CISA 2027 is open.</p>
            <a class="button" href={event.registration.url}>
              {event.registration.label}
              <Icon name="external" size={18} />
            </a>
          </>
        ) : (
          <p>Registration details and rates will be announced.</p>
        )}
        <a class="button" href={href('/downloads/cisa-2027.ics')} download>
          Add to your calendar <Icon name="download" size={18} />
        </a>
      </section>
    </aside>
  </div>
  <section class="section wrap border-section">
    <h2>Frequently asked questions</h2>
    <div class="faq section-copy">
      <details>
        <summary>Is CISA 2027 an in-person conference?</summary>
        <p>
          Yes. The 2027 call for papers specifies an in-person event at the University of Maryland.
          Authors must present live for their papers to be published in IEEE Xplore.
        </p>
      </details>
      <details>
        <summary>Where on campus will the conference take place?</summary>
        <p>The building, rooms, and arrival instructions will be announced.</p>
      </details>
      <details>
        <summary>When will registration and hotel information be available?</summary>
        <p>Registration and recommended accommodation details will be published when confirmed.</p>
      </details>
      <details>
        <summary>Who handles accessibility and travel inquiries?</summary>
        <p>
          Contact <a href={`mailto:${event.email}`}>{event.email}</a> with questions or access
          requirements.
        </p>
      </details>
    </div>
  </section>
</Base>
