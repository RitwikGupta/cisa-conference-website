---
import Base from '../layouts/Base.astro';
import { href } from '../lib/urls';
---

<Base title="Page not found" description="Find your way back to CISA 2027." noindex>
  <section class="wrap simple-page">
    <p class="eyebrow">404 / A DIFFERENT PERSPECTIVE</p>
    <h1>This page is out of view.</h1>
    <p class="section-intro">
      The link may have changed. You can find the program, call for papers, and attendance
      information from the homepage.
    </p>
    <p style="margin-top:30px">
      <a class="button" href={href('/')}>
        Back to CISA 2027 →
      </a>
    </p>
  </section>
</Base>
