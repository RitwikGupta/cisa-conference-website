---
import type { CollectionEntry } from 'astro:content';
import { themes } from '../lib/content';
import { href } from '../lib/urls';
interface Props {
  expanded?: boolean;
  entries?: Pick<CollectionEntry<'themes'>, 'id' | 'data'>[];
  programPath?: string;
}
const { expanded = false, entries = themes, programPath = '/program/' } = Astro.props;
---

<div class="theme-grid">
  {entries.map(({ id, data }) => (
    <article class="theme" id={expanded ? id : undefined}>
      <h3>{expanded ? data.title : <a href={href(`${programPath}#${id}`)}>{data.title}</a>}</h3>
      <p>{data.description}</p>
      <p class="theme-examples">{data.examples.join('; ')}.</p>
    </article>
  ))}
</div>
