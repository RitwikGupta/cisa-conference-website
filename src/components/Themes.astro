---
import { themes } from '../lib/content';
import { href } from '../lib/urls';
interface Props {
  expanded?: boolean;
}
const { expanded = false } = Astro.props;
---

<div class="theme-grid">
  {themes.map(({ id, data }) => (
    <article class="theme" id={expanded ? id : undefined}>
      <h3>{expanded ? data.title : <a href={href(`/program/#${id}`)}>{data.title}</a>}</h3>
      <p>{data.description}</p>
      <p class="theme-examples">{data.examples.join('; ')}.</p>
    </article>
  ))}
</div>
