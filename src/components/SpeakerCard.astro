---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/urls';
interface Props {
  speaker: Pick<CollectionEntry<'speakers'>, 'id' | 'data'>;
  headingLevel?: 'h2' | 'h3';
  profileBase?: string;
  profileFragments?: boolean;
}
const {
  speaker,
  headingLevel: Heading = 'h3',
  profileBase = '/speakers/',
  profileFragments = false,
} = Astro.props;
const { data } = speaker;
---

<article class="speaker-card">
  {data.portrait && (
    <Image
      src={data.portrait}
      alt={data.name}
      widths={[320, 480, 640]}
      sizes="(max-width: 639px) 100vw, 33vw"
      width={480}
      height={480}
      fit="cover"
      loading="lazy"
    />
  )}
  <Heading>
    <a
      href={href(
        profileFragments ? `${profileBase}#${speaker.id}` : `${profileBase}${speaker.id}/`,
      )}
    >
      {data.name}
    </a>
  </Heading>
  <p class="speaker-affiliation">{data.affiliation}</p>
  <p class="speaker-role">{data.role}</p>
  {data.talkTitle && <p class="speaker-talk">{data.talkTitle}</p>}
</article>
