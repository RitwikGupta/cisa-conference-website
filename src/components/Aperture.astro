---
import Icon from './Icon.astro';
// One continuous camera pass, followed by a smooth return during the reconstruction hold/reset.
const cameraAt = (time: number) => {
  const phase = time % 12;
  const progress =
    phase <= 8
      ? (1 - Math.cos((Math.PI * phase) / 8)) / 2
      : (1 + Math.cos((Math.PI * (phase - 8)) / 4)) / 2;
  const angle = ((-62 + progress * 124) * Math.PI) / 180;
  const x = 1060 + Math.cos(angle) * 305;
  const y = 280 + Math.sin(angle) * 230;
  return { x, y, facing: (Math.atan2(y - 280, x - 1090) * 180) / Math.PI };
};
const samples = Array.from({ length: 9 }, (_, i) => {
  const delay = 0.1 + i * 0.85;
  const emittedAt = delay + 0.06;
  const receivedAt = delay + 0.86;
  const emitted = cameraAt(emittedAt);
  const received = cameraAt(receivedAt);
  const pathsFrom = ({ x, y }: { x: number; y: number }) =>
    [235, 325].map((targetY) => `M${x} ${y}Q1185 ${y} 1090 ${targetY}`);
  return {
    ...emitted,
    delay,
    emittedAt,
    receivedAt,
    paths: pathsFrom(emitted),
    echoPaths: pathsFrom(received),
  };
});
const arcStart = cameraAt(0);
const arcEnd = cameraAt(8);
// Include exact emission/reception times so each ray meets the animated camera precisely.
const cameraTimes = [
  ...new Set([
    ...Array.from({ length: 61 }, (_, i) => i / 5),
    ...samples.flatMap(({ emittedAt, receivedAt }) => [emittedAt, receivedAt]),
  ]),
].sort((a, b) => a - b);
const cameraFrames = cameraTimes
  .map((time) => {
    const { x, y, facing } = cameraAt(time);
    return `${((time / 12) * 100).toFixed(5)}% { transform: translate(${x.toFixed(3)}px, ${y.toFixed(3)}px) rotate(${facing.toFixed(3)}deg); }`;
  })
  .join('\n');
---

<figure class="aperture" data-aperture>
  <svg
    class="aperture-svg"
    viewBox="0 0 1440 560"
    preserveAspectRatio="xMaxYMid meet"
    fill="none"
    role="img"
    aria-labelledby="aperture-title"
    aria-describedby="aperture-description"
  >
    <title id="aperture-title">Synthetic-aperture imaging</title>
    <desc id="aperture-description">
      Schematic of measurements collected at nine positions reconstructing a terrapin. A camera
      moves continuously along the sampling arc while pulses travel to the turtle. Reflected echoes
      meet the camera at its new position, where a ring marks reception. As measurements accumulate,
      a blurred estimate resolves into the turtle’s outline and shell pattern, a reference to the
      University of Maryland.
    </desc>
    <defs>
      <radialGradient id="reconstruction-glow">
        <stop stop-color="#087F83" stop-opacity=".55" />
        <stop offset=".35" stop-color="#087F83" stop-opacity=".3" />
        <stop offset="1" stop-color="#087F83" stop-opacity="0" />
      </radialGradient>
      <filter id="terrapin-soft" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="4" />
      </filter>
      <!-- Original top-view terrapin drawing; shared by the two reconstruction estimates. -->
      <g
        id="terrapin-outline"
        fill="#C4DED3"
        stroke="#087F83"
        stroke-width="2.2"
        stroke-linejoin="round"
        stroke-linecap="round"
      >
        <path d="M-11 73L0 111L11 73" />
        <path d="M-17-68L-18-92C-25-98-23-119-12-125Q0-132 12-125C23-119 25-98 18-92L17-68" />
        <path id="terrapin-foreleg" d="M-43-49C-64-60-88-56-101-38L-96-24C-81-22-62-29-49-21" />
        <use href="#terrapin-foreleg" transform="scale(-1 1)" />
        <path id="terrapin-hindleg" d="M-47 45C-73 48-87 64-83 83L-66 91C-53 81-38 70-32 60" />
        <use href="#terrapin-hindleg" transform="scale(-1 1)" />
        <path
          d="M0-83C45-85 67-40 67 7C67 56 32 88 0 90C-35 88-67 52-67 7C-67-39-46-83 0-83Z"
          fill="#E7EFEA"
        />
      </g>
    </defs>
    <g class="aperture-traces" stroke="#087F83" stroke-opacity=".12" stroke-width="1.3">
      <path d="M-80 15Q540 15 1090 235M-80 110Q540 110 1090 235" />
      <path d="M-80 450Q540 450 1090 325M-80 550Q540 550 1090 325" />
    </g>
    <g class="aperture-measurements">
      <path
        d={`M${arcStart.x} ${arcStart.y}A305 230 0 0 1 ${arcEnd.x} ${arcEnd.y}`}
        stroke="#087F83"
        stroke-opacity=".6"
        stroke-width="1.8"
      />
      {samples.map((sample) => (
        <g class="aperture-sample" style={`--sample-delay:${sample.delay}s`}>
          {sample.paths.map((d) => (
            <path
              d={d}
              class="aperture-beam"
              stroke="#087F83"
              stroke-opacity=".18"
              stroke-width="1.3"
            />
          ))}
          <circle
            cx={sample.x}
            cy={sample.y}
            r="3"
            fill="#F7F8F5"
            stroke="#087F83"
            stroke-opacity=".4"
            stroke-width="1"
          />
          <g class="aperture-signal aperture-motion">
            <circle cx={sample.x} cy={sample.y} r="9" fill="#087F83" opacity=".14" />
            <circle cx={sample.x} cy={sample.y} r="3" fill="#06676B" />
          </g>
          {sample.paths.map((d) => (
            <path
              d={d}
              class="aperture-packet aperture-motion"
              pathLength="100"
              stroke="#06676B"
              stroke-width="2.8"
              stroke-linecap="round"
              stroke-dasharray="12 120"
              stroke-dashoffset="12"
            />
          ))}
          {sample.echoPaths.map((d) => (
            <path
              d={d}
              class="aperture-echo aperture-motion"
              pathLength="100"
              stroke="#0C9297"
              stroke-width="3.6"
              stroke-linecap="round"
              stroke-dasharray="12 120"
              stroke-dashoffset="-100"
            />
          ))}
        </g>
      ))}
      <g class="aperture-camera aperture-motion">
        <circle r="21" fill="#F7F8F5" fill-opacity=".85" />
        <g fill="#F7F8F5" stroke="#06676B" stroke-width="2" stroke-linejoin="round">
          <path d="M-8-4L-16-8V8L-8 4" fill="#C4DED3" />
          <rect x="-8" y="-9" width="21" height="18" rx="3" />
          <path d="M-3-9V-12H6V-9" />
          <circle cx="2.5" r="4" fill="#087F83" fill-opacity=".16" />
        </g>
        {samples.map((sample) => (
          <circle
            class="aperture-reception aperture-motion"
            style={`--sample-delay:${sample.delay}s`}
            r="18"
            stroke="#0C9297"
            stroke-width="2.2"
          />
        ))}
      </g>
    </g>
    <g class="aperture-focus" transform="translate(1090 280) rotate(18)">
      <g class="aperture-coarse aperture-motion" data-reconstruction="coarse">
        <ellipse rx="104" ry="132" fill="url(#reconstruction-glow)" />
        <ellipse cy="-91" rx="40" ry="56" fill="url(#reconstruction-glow)" opacity=".6" />
        {[-1, 1].map((side) => (
          <g opacity=".45">
            <ellipse cx={side * 65} cy="-36" rx="54" ry="37" fill="url(#reconstruction-glow)" />
            <ellipse cx={side * 53} cy="64" rx="44" ry="44" fill="url(#reconstruction-glow)" />
          </g>
        ))}
      </g>
      <g class="aperture-intermediate aperture-motion" data-reconstruction="intermediate">
        <use href="#terrapin-outline" filter="url(#terrapin-soft)" opacity=".8" />
      </g>
      <g class="aperture-resolved aperture-motion" data-reconstruction="resolved">
        <use href="#terrapin-outline" />
        <g stroke="#087F83" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
          <path d="M0-69C36-70 53-31 53 8C53 47 28 75 0 77C-29 75-53 47-53 8C-53-31-36-70 0-69Z" />
          <path
            d="M0-69L-19-47L-18-20L-23 8L-19 38L0 63L19 38L23 8L18-20L19-47Z"
            fill="#087F83"
            fill-opacity=".1"
          />
          <path d="M-19-47L0-37L19-47M-18-20L0-10L18-20M-23 8L0 19L23 8M-19 38L0 47L19 38M0 63V77" />
          <path d="M-19-47L-35-52M19-47L35-52M-18-20L-49-23M18-20L49-23M-23 8L-53 14M23 8L53 14M-19 38L-40 52M19 38L40 52" />
          <path d="M-35-52L-44-59M35-52L44-59M-49-23L-62-25M49-23L62-25M-53 14L-66 16M53 14L66 16M-40 52L-50 61M40 52L50 61M0 77V90" />
          <path d="M-13-96L-8-88M13-96L8-88M-94-40L-87-35M94-40L87-35M-80 76L-72 78M80 76L72 78" />
        </g>
        <g fill="#06676B">
          <circle cx="-11" cy="-111" r="2.2" />
          <circle cx="11" cy="-111" r="2.2" />
        </g>
      </g>
    </g>
  </svg>
  <button
    class="aperture-toggle"
    type="button"
    data-playback
    hidden
    aria-label="Pause aperture animation"
    title="Pause aperture animation"
  >
    <Icon name="pause" size={18} class="pause-icon" />
    <Icon name="play" size={18} class="play-icon" />
  </button>
</figure>

<style is:inline set:html={`@keyframes aperture-camera-move {${cameraFrames}}`} />

<script>
  document.querySelectorAll<HTMLElement>('[data-aperture]').forEach((figure) => {
    const button = figure.querySelector<HTMLButtonElement>('[data-playback]')!;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;
    let userPaused = false;
    const syncPlayback = () => {
      const motionAllowed = !motion.matches;
      figure.classList.toggle('has-motion', motionAllowed);
      figure.classList.toggle(
        'is-running',
        motionAllowed && inView && !document.hidden && !userPaused,
      );
      figure.classList.toggle('user-paused', userPaused);
      button.hidden = !motionAllowed;
      const label = userPaused ? 'Resume aperture animation' : 'Pause aperture animation';
      button.setAttribute('aria-label', label);
      button.title = label;
    };
    button.addEventListener('click', () => {
      userPaused = !userPaused;
      syncPlayback();
    });
    motion.addEventListener('change', syncPlayback);
    document.addEventListener('visibilitychange', syncPlayback);
    const observer = new IntersectionObserver((entries) => {
      inView = entries.some((entry) => entry.isIntersecting);
      syncPlayback();
    });
    syncPlayback();
    observer.observe(figure);
  });
</script>
