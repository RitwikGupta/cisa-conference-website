---
import Icon from './Icon.astro';
const samples = Array.from({ length: 9 }, (_, i) => {
  const angle = ((-65 + i * 16.25) * Math.PI) / 180;
  return { x: 470 - Math.cos(angle) * 410, y: 280 + Math.sin(angle) * 310 };
});
---

<figure class="aperture" data-aperture>
  <svg
    class="aperture-svg"
    viewBox="0 0 1440 560"
    preserveAspectRatio="none"
    fill="none"
    role="img"
    aria-labelledby="aperture-title"
    aria-describedby="aperture-description"
  >
    <title id="aperture-title">Synthetic-aperture imaging</title>
    <desc id="aperture-description">
      Measurements from positions along an arc contribute to two resolved image features.
    </desc>
    <defs>
      <radialGradient id="point-glow">
        <stop stop-color="#087F83" stop-opacity=".2" />
        <stop offset="1" stop-color="#087F83" stop-opacity="0" />
      </radialGradient>
      <linearGradient
        id="beam-gradient"
        x1="60"
        y1="280"
        x2="1170"
        y2="280"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#087F83" stop-opacity=".3" />
        <stop offset="1" stop-color="#087F83" stop-opacity=".55" />
      </linearGradient>
    </defs>
    <path
      d="M296.727 -.955A410 310 0 0 0 296.727 560.955"
      stroke="#087F83"
      stroke-opacity=".35"
      stroke-width="1.5"
    />
    {samples.map((sample, i) => (
      <g class="aperture-sample" style={`--sweep:aperture-sample-${i}`}>
        <circle
          cx={sample.x}
          cy={sample.y}
          r="8"
          fill="#F7F8F5"
          stroke="#087F83"
          stroke-opacity=".35"
        />
        <circle cx={sample.x} cy={sample.y} r="2.7" fill="#087F83" opacity=".3" />
        <g class="aperture-signal">
          <path
            d={`M${sample.x} ${sample.y}Q760 ${sample.y} 1170 260`}
            stroke="url(#beam-gradient)"
          />
          <path
            d={`M${sample.x} ${sample.y}Q760 ${sample.y} 1170 354`}
            stroke="url(#beam-gradient)"
            stroke-opacity=".7"
          />
          <circle cx={sample.x} cy={sample.y} r="18" fill="#087F83" opacity=".1" />
          <circle cx={sample.x} cy={sample.y} r="3.4" fill="#06676B" />
        </g>
      </g>
    ))}
    <g class="aperture-focus">
      {[260, 354].map((y) => (
        <g>
          <circle cx="1170" cy={y} r="86" fill="url(#point-glow)" />
          {[18, 32, 49].map((r, i) => (
            <ellipse
              cx="1170"
              cy={y}
              rx={r}
              ry={r * 0.65}
              stroke="#087F83"
              stroke-opacity={0.35 - i * 0.09}
              stroke-width=".7"
            />
          ))}
          <ellipse cx="1170" cy={y} rx="6" ry="4" fill="#087F83" />
          <circle cx="1170" cy={y} r="2" fill="#06676B" />
        </g>
      ))}
    </g>
  </svg>
  <button
    class="aperture-toggle"
    type="button"
    data-playback
    hidden
    aria-label="Pause aperture animation"
    title="Pause aperture animation"
  >
    <Icon name="pause" size={18} class="pause-icon" />
    <Icon name="play" size={18} class="play-icon" />
  </button>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-aperture]').forEach((figure) => {
    const button = figure.querySelector<HTMLButtonElement>('[data-playback]')!;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let inView = false;
    let userPaused = false;
    const syncPlayback = () => {
      const motionAllowed = !motion.matches;
      figure.classList.toggle('has-motion', motionAllowed);
      figure.classList.toggle(
        'is-running',
        motionAllowed && inView && !document.hidden && !userPaused,
      );
      figure.classList.toggle('user-paused', userPaused);
      button.hidden = !motionAllowed;
      const label = userPaused ? 'Resume aperture animation' : 'Pause aperture animation';
      button.setAttribute('aria-label', label);
      button.title = label;
    };
    button.addEventListener('click', () => {
      userPaused = !userPaused;
      syncPlayback();
    });
    motion.addEventListener('change', syncPlayback);
    document.addEventListener('visibilitychange', syncPlayback);
    const observer = new IntersectionObserver((entries) => {
      inView = entries.some((entry) => entry.isIntersecting);
      syncPlayback();
    });
    syncPlayback();
    observer.observe(figure);
  });
</script>
